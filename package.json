{
  "name": "@b4moss/calengine",
  "version": "0.4.2",
  "description": "UI-agnostic calendar date math, grids, and event layout for B4M products.",
  "type": "module",
  "license": "MIT",
  "author": "Kohki SHIKATA <kohki.shikata@gmail.com>",
  "homepage": "https://github.com/b4moss/calengine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4moss/calengine.git"
  },
  "bugs": {
    "url": "https://github.com/b4moss/calengine/issues"
  },
  "keywords": [
    "calendar",
    "date",
    "datetime",
    "timezone",
    "dst",
    "grid",
    "events",
    "layout",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.2",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
